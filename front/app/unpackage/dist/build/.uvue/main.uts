__uniRoutes.push({ path: "pages/tabbar/Myself/password/password", component: GenPagesTabbarMyselfPasswordPasswordClass, meta: { isQuit: false } as UniPageMeta, style: utsMapOf([["navigationBarTitleText","密码修改"]]) } as UniPageRoute)
