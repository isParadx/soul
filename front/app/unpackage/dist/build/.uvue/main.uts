__uniRoutes.push({ path: "pages/tabbar/Home/detil/detil", component: GenPagesTabbarHomeDetilDetilClass, meta: { isQuit: false } as UniPageMeta, style: utsMapOf([["navigationBarTitleText","医师详情"]]) } as UniPageRoute)
__uniRoutes.push({ path: "pages/tabbar/Myself/Myself", component: GenPagesTabbarMyselfMyselfClass, meta: { isQuit: false } as UniPageMeta, style: utsMapOf([["navigationStyle","custom"]]) } as UniPageRoute)
