import App from './App.uvue'

import { createSSRApp } from 'vue'


export function createApp() {
	const app = createSSRApp(App)
	  app.config.globalProperties.$u = {
	    baseURL: 'http://localhost:8080'
	  };
	return {
		app
	}
}

export function main(app: IApp) {
    definePageRoutes();
    defineAppConfig();
    
    (createApp()['app'] as VueApp).mount(app);
}

export class UniAppConfig extends io.dcloud.uniapp.appframe.AppConfig {
    override name: string = "心灵之旅"
    override appid: string = "__UNI__6782D0F"
    override versionName: string = "1.0.0"
    override versionCode: string = "100"
    override uniCompilerVersion: string = "4.29"
    
    constructor() { super() }
}

