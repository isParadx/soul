}
const __uniTabBar: Map<string, any | null> | null = utsMapOf([["color","#7A7E83"],["selectedColor","#3cc51f"],["backgroundColor","#ffffff"],["borderStyle","black"],["position","bottom"],["list",[utsMapOf([["pagePath","pages/tabbar/Home/Home"],["text","首页"],["iconPath","static/tabbar/home1.png"],["selectedIconPath","static/tabbar/home2.png"]]),utsMapOf([["pagePath","pages/tabbar/Order/Order"],["text","咨询预约"],["iconPath","static/tabbar/order1.png"],["selectedIconPath","static/tabbar/order2.png"]]),utsMapOf([["pagePath","pages/tabbar/Myself/Myself"],["text","个人中心"],["iconPath","static/tabbar/myself1.png"],["selectedIconPath","static/tabbar/myself2.png"]])]]])
const __uniLaunchPage: Map<string, any | null> = utsMapOf([["url","pages/loAre/login/login"],["style",utsMapOf([["navigationStyle","custom"]])]])
