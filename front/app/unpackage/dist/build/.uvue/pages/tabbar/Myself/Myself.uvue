
const __sfc__ = defineComponent({
  data() {
    return {
      nickname: 'hi!欢迎使用',
      menuItems: [
        { icon: 'icon-info', text: '个人信息', url: '/pages/tabbar/Myself/profile/profile' },
        { icon: 'icon-lock', text: '密码修改', url: '/pages/tabbar/Myself/password/password' },
        { icon: 'icon-advice;', text: '意见反馈', url: '/pages/tabbar/Myself/advice/advice' }
      ]
    };
  },
  onLoad() {
  	uni.getStorage({
  			  key:'token',
  			  success:(res)=>{
  				 this.token=res.data;
  			}
  	}) 
  },
  methods: { 
    navigateTo(url) {
		uni.navigateTo({
			url: url
		});
    },
    logout() {
      uni.removeStorage({
		  key:'token',
		  success:function(){
			  uni.clearStorage()
			  uni.showToast({
				  title:'退出成功，请重新登录',
				  icon:'none',
				  duration: 1000
			  }),
			  setTimeout(() => {
			          uni.navigateTo({
			            url: '/pages/loAre/login/login'
			          });
			        }, 1000);
			  
		  }
	  })
    }
  }
});

