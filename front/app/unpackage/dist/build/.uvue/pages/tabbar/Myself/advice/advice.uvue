
const __sfc__ = defineComponent({
  data() {
    return {
      feedbackContent: '', // 用户输入的反馈内容
      feedbackLength: 200, // 初始剩余字数
    };
  },
  watch: {
    feedbackContent(newVal) {
      this.feedbackLength = 200 - newVal.length;
    }
  },
  methods: {
    // 提交反馈
    submitFeedback() {
      if (this.feedbackContent.trim() === '') {
        uni.showToast({
          title: '请输入意见反馈内容',
          icon: 'none'
        });
        return;
      }else{
		  uni.request({
		    url: this.$u.baseURL+'/advice/putAdvice',
		    method: 'POST',
		    header:{
		  	  token:this.token
		    },
		    data: this.feedbackContent,
		    success: (res) => {
				console.log(res);
		      if (res.data.code == 200) {
		  		uni.showToast({
		  						  title:'提交成功，感谢您宝贵的意见！',
		  						  icon:'none',
		  						  duration: 500
		  		}),
		  		setTimeout(() => {
		  		        uni.switchTab({
		  		          url: '/pages/tabbar/Myself/Myself'
		  		        });
		  		      }, 500);
		      } else {
		        uni.showToast({
		          title: '保存失败，请重试',
		          icon: 'none'
		        });
		      }
		    },
		    fail: () => {
		      uni.showToast({
		        title: '网络请求失败',
		        icon: 'none'
		      });
		    }
		  });
	  }
      
    }
  }
});

export default __sfc__
