
const __sfc__ = defineComponent({
  data() {
    return {
      token: '',
      user: [],
      currentStatus: 'all',
      expandedOrder: null, // 用于跟踪当前展开的订单项
      orderStatus: [
        { name: '全部订单', value: 'all' },
        { name: '未开始', value: '未开始' },
        { name: '进行中', value: '进行中' },
        { name: '已结束', value: '已结束' }
      ],
      orders: [],
    };
  },
  onLoad(){
    uni.getStorage({
       key: 'token',
       success: (res) => {
         this.token = res.data;
         this.getOrderInfo();
       }
     });
  },
  computed: {
    filteredOrders() {
      if (this.currentStatus === 'all') {
        return this.orders;
      } else {
        return this.orders.filter(order => order.status === this.currentStatus);
      }
    }
  },
  methods: {
    changeStatus(status) {
      this.currentStatus = status;
      this.expandedOrder = null;
    },
    toggleDetail(order) {
      // 如果点击的是当前展开的订单项，则将其折叠
      if (this.expandedOrder === order) {
        this.expandedOrder = null;
      } else {
        // 否则展开点击的订单项，并折叠其他所有订单项
        this.expandedOrder = order;
      }
    },
    //获取订单列表
    getOrderInfo(){
      //先通过token获取用户信息，
      uni.request({
        url:this.$u.baseURL+'/user/getUserInfo',
        method: 'GET',
        header:{
          "token":this.token,
        },
        success: (res) => {
          this.user=res.data.data.loginUser;
          //根据userid来查用户的订单
          this.getAllOrder();
        },
        fail: () => {
          uni.showToast({
            title: '网络请求失败',
            icon: 'none'
          });
        }
      });
    },
    async getAllOrder() {
      try {
        const res = await uni.request({
          url: this.$u.baseURL + '/consult/checkOrder',
          method: 'GET',
          data: {
              keywords: this.user.userid
            }
        });
        this.orders = res.data.data;
        await this.updateOrderNames();
      } catch (err) {
        uni.showToast({
          title: '请求失败，请重试',
          icon: 'none'
        });
      }
    },
    async updateOrderNames() {
      for (const order of this.orders) {
        const docName = await this.getAllDoctor(order.docId);
        order.name = docName;
      }
    },
    async getAllDoctor(docid) {
      try {
        const res = await uni.request({
          url: this.$u.baseURL + '/doctor/getAllDocter',
          method: 'GET',
          data: { keywords: docid },
        });
        return res.data.data[0].name;
      } catch (err) {
        uni.showToast({
          title: '请求失败，请重试',
          icon: 'none'
        });
        return ''; // 返回空字符串或一个默认值
      }
    },
  },
});

export default __sfc__
