
const __sfc__ = defineComponent({
  data() {
    return {
		token:'',
		user: {},
		genders: ['男', '女'], // 新增性别选项
    };
  },
  onLoad(){
	  uni.getStorage({
		  key:'token',
		  success:(res)=>{
			 this.token=res.data;
			 this.getuserInfo()
		  }
	  }) 
  },
  methods: {
    //获取用户信息请求
	getuserInfo(){
		uni.request({
		  url:this.$u.baseURL+'/user/getUserInfo',
		  method: 'GET',
		  header:{
			  "token":this.token,
		  },
		  success: (res) => {
		   this.user=res.data.data.loginUser
		  },
		  fail: () => {
		    uni.showToast({
		      title: '网络请求失败',
		      icon: 'none'
		    });
		  }
		});
	},
	
	//修改头像
	editAvatar() {
      console.log('点击了修改头像');
      // 这里可以添加代码来处理头像的修改，比如打开一个图片选择器
    },
	
	//修改性别
	onGenderChange(e) {
	  this.user.sex = e.detail.value;
	},
    saveInfo() {
       if (this.user.nickname!==''&&this.user.sex!==''&&this.phone!==''&&this.email!==null) {
        uni.request({
          url: this.$u.baseURL+'/user/changeUserInfo',
          method: 'POST',
		  header:{
			  "token":this.token
		  },
          data: this.user,
          success: (res) => {
            if (res.data.code == 200) {
				uni.showToast({
								  title:'修改成功！',
								  icon:'none',
								  duration: 500
				}),
				setTimeout(() => {
				        uni.switchTab({
				          url: '/pages/tabbar/Myself/Myself'
				        });
				      }, 500);
            } else {
              uni.showToast({
                title: '保存失败，请重试',
                icon: 'none'
              });
            }
          },
          fail: () => {
            uni.showToast({
              title: '网络请求失败',
              icon: 'none'
            });
          }
        });
		this.getuserInfo()
      } else {
        uni.showToast({
          title: '请填写所有字段',
          icon: 'none'
        });
      }
    }
  }
});

