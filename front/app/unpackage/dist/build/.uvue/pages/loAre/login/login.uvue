      type: "text",
      modelValue: _ctx.username,
      onInput: ($event: InputEvent) => {(_ctx.username) = $event.detail.value},
      placeholder: "请输入用户名"
    }), null, 40 /* PROPS, NEED_HYDRATION */, ["modelValue", "onInput"]),
    createElementVNode("input", utsMapOf({
