<template>
  <view class="order-container">
    <view class="order-tab">
      <view 
        v-for="(status, index) in orderStatus"
        :key="index"
        :class="{ 'active': currentStatus === status.value }"
        @click="changeStatus(status.value)"
      >
        {{ status.name }}
      </view>
    </view>
    <view class="order-list">
      <view v-for="order in filteredOrders" :key="order.id" class="order-item">
        <view class="order-item-head">
          <view class="order-item-head-info">
            <text>订单号：{{ order.id }}</text>
            <text class="status">{{ order.status }}</text>
          </view>
          <text @click="toggleDetail(order)" class="clicktext">↓</text>
        </view> 
        <view v-if="expandedOrder === order" class="order-detail">
          <view>
            <text>医师编号：{{ order.docId }}</text>
            <text>医师姓名：{{ order.name }}</text>
            <text>预约时间：{{ order.appointmentTime }}</text>
          </view>
          <view v-if="order.status === '已结束'" class="feedback-box">
            <text>反馈：{{ order.feedback }}</text>
          </view>
        </view>
      </view>
    </view>
	 <text class="text-loading">~~加载完毕~~</text>
  </view>
</template>

<script>
export default {
  data() {
    return {
      token: '',
      user: [],
      currentStatus: 'all',
      expandedOrder: null, // 用于跟踪当前展开的订单项
      orderStatus: [
        { name: '全部订单', value: 'all' },
        { name: '未开始', value: '未开始' },
        { name: '进行中', value: '进行中' },
        { name: '已结束', value: '已结束' }
      ],
      orders: [],
    };
  },
  onLoad(){
    uni.getStorage({
       key: 'token',
       success: (res) => {
         this.token = res.data;
         this.getOrderInfo();
       }
     });
  },
  computed: {
    filteredOrders() {
      if (this.currentStatus === 'all') {
        return this.orders;
      } else {
        return this.orders.filter(order => order.status === this.currentStatus);
      }
    }
  },
  methods: {
    changeStatus(status) {
      this.currentStatus = status;
      this.expandedOrder = null;
    },
    toggleDetail(order) {
      // 如果点击的是当前展开的订单项，则将其折叠
      if (this.expandedOrder === order) {
        this.expandedOrder = null;
      } else {
        // 否则展开点击的订单项，并折叠其他所有订单项
        this.expandedOrder = order;
      }
    },
    //获取订单列表
    getOrderInfo(){
      //先通过token获取用户信息，
      uni.request({
        url:this.$u.baseURL+'/user/getUserInfo',
        method: 'GET',
        header:{
          "token":this.token,
        },
        success: (res) => {
          this.user=res.data.data.loginUser;
          //根据userid来查用户的订单
          this.getAllOrder();
        },
        fail: () => {
          uni.showToast({
            title: '网络请求失败',
            icon: 'none'
          });
        }
      });
    },
    async getAllOrder() {
      try {
        const res = await uni.request({
          url: this.$u.baseURL + '/consult/checkOrder',
          method: 'GET',
          data: {
              keywords: this.user.userid
            }
        });
        this.orders = res.data.data;
        await this.updateOrderNames();
      } catch (err) {
        uni.showToast({
          title: '请求失败，请重试',
          icon: 'none'
        });
      }
    },
    async updateOrderNames() {
      for (const order of this.orders) {
        const docName = await this.getAllDoctor(order.docId);
        order.name = docName;
      }
    },
    async getAllDoctor(docid) {
      try {
        const res = await uni.request({
          url: this.$u.baseURL + '/doctor/getAllDocter',
          method: 'GET',
          data: { keywords: docid },
        });
        return res.data.data[0].name;
      } catch (err) {
        uni.showToast({
          title: '请求失败，请重试',
          icon: 'none'
        });
        return ''; // 返回空字符串或一个默认值
      }
    },
  },
};
</script>

<style>  
.order-container {
  height: 100%;
  background-color: #e6e6fa;
  padding: 15px;
}
.order-tab {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  border-bottom: 1px solid #ccc;
}
.order-tab view {
  padding: 10px;
  cursor: pointer;
}
.order-tab .active {
  border-bottom: 2px solid blue;
}

/* 订单列表样式 */
.order-list {
  margin-top: 10px;
}

.order-item {
  margin-bottom: 20px;
  padding: 10px;
  border: 1px solid #eee;
  border-radius: 10px;
  background-color: #fff;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
}
.order-item:hover {
  background-color: #f9f9f9;
}

.order-item-head{
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.order-item-head-info{
  width: 50%;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.clicktext{
  font-size: 14px;
  color: #666;
}

.order-detail {
  width: 90%;
  margin-top: 10px;
  padding: 10px;
  border: 1px solid #ccc;
  border-radius: 5px;
  background-color: #fafafa;
}
.status {
  color: red;
  font-weight: bold;
}

.feedback-box {
  margin-top: 10px;
  padding: 10px;
  border: 1px solid #ccc;
  border-radius: 5px;
  background-color: #f0f0f0; /* 浅灰色背景框 */
}

.text-loading {
  font-size: 12px; 
  color: #888; 
  text-align: center; 
  margin-top: 10px; 
}
</style>