<template>
  <view class="page">
    <!-- 医师名片 -->
    <view class="doc-card">
      <view class="doc-avatar">
        <image class="doc-avatar-img" src="/static/user.png" mode="aspectFill" />
      </view>
      <view class="doc-meta">
        <text class="doc-name">{{ doctor.name || '医师' }}</text>
        <view class="doc-tags">
          <text class="doc-tag" v-for="(item, index) in doctor.type" :key="index">{{ item }}</text>
        </view>
      </view>
    </view>

    <!-- 分段标签 -->
    <view class="seg">
      <view class="seg-item" :class="{ 'seg-item-on': currentTab === 0 }" @click="switchTab(0)">个人简介</view>
      <view class="seg-item" :class="{ 'seg-item-on': currentTab === 1 }" @click="switchTab(1)">擅长领域</view>
      <view class="seg-item" :class="{ 'seg-item-on': currentTab === 2 }" @click="switchTab(2)">医师寄语</view>
    </view>

    <!-- 内容面板 -->
    <view class="panel">
      <view v-show="currentTab === 0" class="paragraph">{{ doctor.intruduce }}</view>
      <view v-show="currentTab === 1" class="tag-wrap">
        <text class="tag" v-for="(item, index) in doctor.type" :key="index">{{ item }}</text>
      </view>
      <view v-show="currentTab === 2" class="paragraph">{{ doctor.say }}</view>
    </view>

    <!-- 咨询须知 -->
    <view class="notice">
      <view class="notice-head">
        <text class="notice-bar"></text>
        <text class="notice-title">咨询须知</text>
      </view>
      <view class="notice-body">
        <view class="notice-line">1、咨询为预约服务，您可选择老师进行预约，每次咨询50分钟或60分钟。</view>
        <view class="notice-line">2、预约成功后，您的预约需咨询师确认并安排咨询时间，请留意您的订单状态。</view>
        <view class="notice-line">3、当订单状态为“准备进行”时，意味着您在24小时之后-48小时之前可随时拜访心理咨询室。</view>
        <view class="notice-line">4、因不可抗力因素变更时间或取消咨询预约，请提前12小时告知咨询师。</view>
      </view>
    </view>

    <!-- 底部操作栏 -->
    <view class="bottom-bar">
      <button class="consult-now" @click="consultNow">立即咨询</button>
    </view>

    <!-- 预约弹窗 -->
    <view class="modal" v-if="isShowModal">
      <view class="sheet">
        <view class="sheet-head">
          <text class="sheet-title">选择预约时间</text>
          <text class="sheet-close" @click="closeModal">✕</text>
        </view>

        <text class="sheet-label">预约日期</text>
        <view class="date-row">
          <view
            class="date-chip"
            v-for="(date, index) in dates"
            :key="index"
            :class="{ 'date-chip-on': selectedDate === date }"
            @click="selectDate(date)"
          >
            <text class="date-day" :class="{ 'date-text-on': selectedDate === date }">{{ dayName(index) }}</text>
            <text class="date-md" :class="{ 'date-text-on': selectedDate === date }">{{ dateShort(date) }}</text>
          </view>
        </view>

        <text class="sheet-label">时间段</text>
        <view class="time-grid">
          <view
            class="time-chip"
            v-for="time in availableTimes"
            :key="time.time"
            :class="{ 'time-chip-on': time.selected, 'time-chip-off': !time.available }"
            @click="selectTime(time)"
          >
            {{ time.time }}
          </view>
        </view>

        <button class="sheet-btn" @click="confirmBooking">确认预约</button>
      </view>
    </view>
  </view>
</template>

<script>
export default {
data() {
  return {
    id: 0,
    doctor: {},
	token:'',
	user:{},
    currentTab: 0,
    isShowModal: false, // 控制弹窗显示
    selectedDate: '', // 选择的日期
    selectedTime: '', // 选择的时间段
    availableTimes: [ // 可用时间段
      { time: '9:00-10:00', selected: false, available: true },
      { time: '10:30-11:30', selected: false, available: true },
      { time: '13:00-14:00', selected: false, available: true },
      { time: '14:30-15:30', selected: false, available: true },
      { time: '16:00-17:00', selected: false, available: true },
      { time: '19:00-20:00', selected: false, available: true },
    ],
    dates: this.getAvailableDates() // 可用日期
  };
},
  onLoad(opt) {
	this.id=opt.docId;
	this.getDoctor(this.id);
	uni.getStorage({
			  key:'token',
			  success:(res)=>{
				 this.token=res.data;
				 this.getuserInfo()
			  }
	}) 
  },
  methods: {
	getDoctor(keywords) {
	  uni.request({
	    url: this.$u.baseURL + '/doctor/getAllDocter',
	    method: 'GET',
	    data: {
	      "keywords": this.id
	    },
	    success: (res) => {
	      if (res.data.code == 200) {
	        const r= res.data.data;
			r[0].type = r[0].type.split(',').map(tag => tag.trim()); // 分割字符串并去除空格
			this.doctor=r[0];
	      }
	    },
	    fail: (err) => {
	      uni.showToast({
	        title: '请求失败，请重试', // 提示的内容
	        icon: 'none' // 没有图标
	      });
	    }
	  });
	},
	
	//获取用户信息请求
	getuserInfo(){
		uni.request({
		  url:this.$u.baseURL+'/user/getUserInfo',
		  method: 'GET',
		  header:{
			  "token":this.token,
		  },
		  success: (res) => {
		   this.user=res.data.data.loginUser;
		  },
		  fail: () => {
		    uni.showToast({
		      title: '网络请求失败',
		      icon: 'none'
		    });
		  }
		});
	},
	
	// 日期展示：今天 / 明天 / 后天
	dayName(index) {
		const names = ['今天', '明天', '后天'];
		return names[index] || '';
	},
	// 日期展示：只取 月.日 部分
	dateShort(date) {
		const parts = String(date).split('-');
		return parts.length > 1 ? parts[1] : date;
	},
	closeModal() {
		this.isShowModal = false;
	},
	
    switchTab(index) {
      this.currentTab = index;
    },
     consultNow() {
        this.isShowModal = true;
        this.selectedDate = this.dates[0]; // 默认选择第一个日期
        this.updateAvailableTimes(); // 更新可用时间段
		console.log(this.selectedDate)
      },
    
     getAvailableDates() {
       const dates = [];
       const baseDate = new Date(); // 保存原始日期
       for (let i = 0; i < 3; i++) {
        const date = new Date(baseDate); // 每次循环都从原始日期开始
			date.setDate(date.getDate() + i);
			const year = date.getFullYear();
			const month = (date.getMonth() + 1).toString().padStart(2, '0');
			const day = date.getDate().toString().padStart(2, '0');
			dates.push(`${year}-${month}.${day}`);
       }
       return dates;
     },
	 passTimeNotChoose(){ 
		 if(this.selectedDate==this.dates[0]){
			 //过期时间不可选
			  this.availableTimes.forEach((item) => {
			 		item.selected=false;
			  })
			 //先根据当前时间判断，将过期时间段不可选
			 const date = new Date();
			 //获取当前的时间时,分
			 const hour = parseInt(date.getHours().toString().padStart(2, '0'));
			 const min =parseInt(date.getMinutes().toString().padStart(2, '0'));
			 //过期时间不可选
			  this.availableTimes.forEach((timeSlot) => {
			 			 timeSlot.available=true
			 	 const res=timeSlot.time.split('-')[0].split(':')
			 	 const reshour = parseInt(res[0], 10);
			 	 const resmin = parseInt(res[1], 10);
			 			if (hour > reshour || (hour === reshour && min > resmin)) {
			 			        timeSlot.available = false;
			 			    }
			  })
		 }else{
			 if(this.selectedDate!=this.dates[0]){
			 	this.availableTimes.forEach((item)=>{
						item.selected=false;
			 			item.available=true;
			 	})
			 }
		}
	 },
    
      updateAvailableTimes() {
		this.passTimeNotChoose();
		//数据库出现的时间不可选
		uni.request({
			url: this.$u.baseURL+'/consult/checkOrder',
			method: 'GET',
			header:{
				"token":this.token
			},
			data:{
				"keyid":this.id
			},
			success: (res) => {
				const resTimes=res.data.data;
				resTimes.forEach((item)=>{
					const parts=item.appointmentTime.split('/')
					const resDate= parts[0];//获取该项预约的日期
					const restime= parts[1];//获取该项预约的时间
					
					console.log(item.docId)
					console.log(this.id)
					
					if(item.docId==this.id){
						if(this.selectedDate==resDate){
							this.availableTimes.forEach((tim)=>{
								if(restime==tim.time){
									tim.available=false
								}
							})
						}
					}
					
			 	})
			},
			fail: (err) => {
				uni.showToast({
					title: '请求失败，请重试',
					icon: 'none'
				});
			}
		});	
      },
    
      selectDate(date) {
		  console.log(date)
        this.selectedDate = date;
        this.selectedTime = '';
        this.updateAvailableTimes(); // 更新可用时间段
      },
    
      selectTime(time) {
		// 已被占用或已过期的时间段不可选择
		if (time.available === false) {
			uni.showToast({
				title: '该时间段不可预约，请选择其他时间',
				icon: 'none'
			});
			return;
		}
        this.availableTimes.forEach((item) => {
          item.selected = item.time === time.time;
        });
        this.selectedTime = time.time;
      },
    
      confirmBooking() {
        // 这里添加预约逻辑
		if(this.selectedTime==''){
			uni.showToast({
				title: '请选择预约时间',
				icon: 'none'
			});
		}else{
			uni.request({
				url: this.$u.baseURL+'/consult/setOrder',
				method: 'POST',
				header:{
					"token":this.token
				},
				data:{
					"docId":this.id,
					"stuId":this.user.userid,
					"appointmentTime":this.selectedDate+'/'+this.selectedTime
				},
				success: (res) => {
					uni.showToast({
					  title: '预约成功',
					  icon: 'success'
					});
					this.isShowModal = false;
				},
				fail: (err) => {
					uni.showToast({
						title: '请求失败，请重试',
						icon: 'none'
					});
				}
			});	
			
		}
      },
  }
};
</script>

<style>
