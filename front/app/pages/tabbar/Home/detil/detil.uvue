  padding: 10px 0;
  border-radius: 14px;
  background-color: #f4f7f6;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.date-chip-on {
  background-image: linear-gradient(135deg, #5b8c8a 0%, #7fb3b0 100%);
}

.date-day {
  font-size: 13px;
  font-weight: 600;
  color: #4a7a78;
}

.date-md {
  font-size: 11px;
  color: #9aa5a3;
  margin-top: 4px;
}

.date-text-on {
  color: #ffffff;
}

/* 时间段胶囊 */
.time-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
}

.time-chip {
  width: 48%;
  height: 44px;
  line-height: 44px;
  text-align: center;
  margin-bottom: 10px;
  border-radius: 12px;
  font-size: 14px;
  color: #33413f;
  background-color: #f4f7f6;
}

.time-chip-on {
  color: #ffffff;
  font-weight: 600;
  background-image: linear-gradient(135deg, #5b8c8a 0%, #7fb3b0 100%);
}

.time-chip-off {
  color: #c3ccca;
  background-color: #f7f8f8;
}

.sheet-btn {
  width: 100%;
  height: 46px;
  line-height: 46px;
  margin-top: 12px;
  font-size: 16px;
  font-weight: 600;
  color: #ffffff;
  border: none;
  border-radius: 23px;
  background-image: linear-gradient(135deg, #5b8c8a 0%, #7fb3b0 100%);
  box-shadow: 0 6px 16px rgba(91, 140, 138, 0.24);
}
</style>
