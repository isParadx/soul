  font-size: 14px;
  color: #5a6a68;
  line-height: 26px;
}

.tag-wrap {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.tag {
  padding: 6px 14px;
  margin-right: 10px;
  margin-bottom: 10px;
  font-size: 13px;
  color: #4A7A78;
  background-color: #EAF3F2;
  border-radius: 999px;
}

/* ---- 咨询须知 ---- */
.notice {
  margin-top: 14px;
  padding: 18px;
  background-color: #ffffff;
  border-radius: 18px;
  box-shadow: 0 6px 20px rgba(91, 140, 138, 0.07);
}

.notice-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 12px;
}

.notice-bar {
  width: 4px;
  height: 15px;
  border-radius: 2px;
  margin-right: 8px;
  background-image: linear-gradient(180deg, #5b8c8a 0%, #7fb3b0 100%);
}

.notice-title {
  font-size: 15px;
  font-weight: 600;
  color: #33413f;
}

.notice-body {
  display: flex;
  flex-direction: column;
}

.notice-line {
  font-size: 13px;
  color: #7c8987;
  line-height: 23px;
  margin-bottom: 8px;
}

/* ---- 底部操作栏 ---- */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
