  background-color: #ffffff;
  box-shadow: 0 -4px 18px rgba(91, 140, 138, 0.10);
}

.consult-now {
  width: 100%;
  height: 48px;
  line-height: 48px;
  font-size: 16px;
  font-weight: 600;
  color: #ffffff;
  border: none;
  border-radius: 24px;
  background-image: linear-gradient(135deg, #5b8c8a 0%, #7fb3b0 100%);
  box-shadow: 0 6px 16px rgba(91, 140, 138, 0.28);
}

/* ---- 预约弹窗 ---- */
.modal {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  background-color: rgba(24, 38, 36, 0.45);
}

.sheet {
  padding: 20px 18px 24px;
  background-color: #ffffff;
  border-top-left-radius: 24px;
  border-top-right-radius: 24px;
}

.sheet-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}

.sheet-title {
  font-size: 17px;
  font-weight: 600;
  color: #33413f;
}

.sheet-close {
  font-size: 16px;
  color: #b3bdbb;
  padding: 4px 6px;
}

.sheet-label {
  display: block;
  font-size: 13px;
  color: #8a9694;
  margin-bottom: 10px;
}

/* 日期胶囊 */
.date-row {
  display: flex;
  flex-direction: row;
  margin-bottom: 18px;
}

.date-chip {
  flex: 1;
