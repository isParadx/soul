  font-size: 19px;
  font-weight: 600;
  color: #ffffff;
}

.doc-tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 10px;
}

.doc-tag {
  padding: 3px 10px;
  margin-right: 8px;
  margin-bottom: 4px;
  font-size: 12px;
  color: #ffffff;
  background-color: rgba(255, 255, 255, 0.22);
  border-radius: 999px;
}

/* ---- 分段标签 ---- */
.seg {
  display: flex;
  flex-direction: row;
  margin-top: 16px;
  padding: 4px;
  background-color: #ffffff;
  border-radius: 14px;
  box-shadow: 0 4px 16px rgba(91, 140, 138, 0.07);
}

.seg-item {
  flex: 1;
  height: 38px;
  line-height: 38px;
  text-align: center;
  font-size: 14px;
  color: #6b7a78;
  border-radius: 11px;
}

.seg-item-on {
  background-image: linear-gradient(135deg, #5b8c8a 0%, #7fb3b0 100%);
  color: #ffffff;
  font-weight: 600;
}

/* ---- 内容面板 ---- */
.panel {
  margin-top: 14px;
  padding: 18px;
  min-height: 130px;
  background-color: #ffffff;
  border-radius: 18px;
  box-shadow: 0 6px 20px rgba(91, 140, 138, 0.07);
}

