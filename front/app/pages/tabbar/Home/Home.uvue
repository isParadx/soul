  font-size: 21px;
  font-weight: 600;
  color: #33413f;
}

.head-sub {
  font-size: 13px;
  color: #9aa5a3;
  margin-top: 6px;
}

/* ---- 搜索框 ---- */
.search-box {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 46px;
  padding: 0 14px;
  background-color: #ffffff;
  border-radius: 14px;
  box-shadow: 0 4px 16px rgba(91, 140, 138, 0.08);
}

.search-icon {
  width: 18px;
  height: 18px;
  margin-right: 8px;
}

.search-input {
  flex: 1;
  height: 46px;
  font-size: 15px;
  color: #33413f;
}

.search-btn {
  font-size: 14px;
  color: #5b8c8a;
  font-weight: 600;
  padding-left: 10px;
}

/* ---- 轮播 ---- */
.swiper {
  width: 100%;
  height: 172px;
  margin-top: 16px;
  border-radius: 18px;
  overflow: hidden;
}

.slide-image {
  width: 100%;
  height: 100%;
  border-radius: 18px;
}

/* ---- 列表 ---- */
.list {
  margin-top: 22px;
}

.list-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}

.list-title {
  font-size: 17px;
  font-weight: 600;
  color: #33413f;
}

.list-count {
  font-size: 12px;
  color: #9aa5a3;
}

.list-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 12px;
  padding: 16px;
  background-color: #ffffff;
  border-radius: 18px;
  box-shadow: 0 6px 20px rgba(91, 140, 138, 0.08);
}

.list-item-avatar {
  width: 58px;
  height: 58px;
  border-radius: 20px;
  margin-right: 14px;
  background-color: #eef3f2;
}

.list-item-info {
  flex: 1;
}

.list-item-name {
  font-size: 16px;
  font-weight: 600;
  color: #33413f;
  margin-bottom: 6px;
}

.list-item-brief {
  font-size: 13px;
  color: #8a9694;
  line-height: 18px;
  margin-bottom: 10px;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.list-item-tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.list-item-tag {
  padding: 3px 10px;
  margin-right: 8px;
  margin-bottom: 6px;
  background-color: #EAF3F2;
  color: #4A7A78;
  border-radius: 999px;
  font-size: 12px;
}

.list-item-arrow {
  font-size: 20px;
  color: #ccd6d4;
  margin-left: 8px;
}

.list-empty {
  text-align: center;
  font-size: 14px;
  color: #9aa5a3;
  padding: 40px 0;
}

.text-loading {
  font-size: 12px;
  color: #b3bdbb;
  text-align: center;
  margin-top: 14px;
}
</style>
