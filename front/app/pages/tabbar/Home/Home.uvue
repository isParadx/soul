<template>
  <view class="page">
    <!-- 顶部问候 -->
    <view class="head">
      <text class="head-title">找到适合你的咨询师</text>
      <text class="head-sub">随时预约 · 安心倾诉</text>
    </view>

    <!-- 搜索框 -->
    <view class="search-box">
      <image class="search-icon" src="/static/home/search.png" mode="aspectFit" />
      <input
        class="search-input"
        type="text"
        v-model="keywords"
        placeholder="搜索医师姓名或擅长领域"
        placeholder-style="color:#a9b4b2;font-size:15px;"
        confirm-type="search"
        @confirm="onSearch"
      />
      <text class="search-btn" @click="onSearch">搜索</text>
    </view>

    <!-- 轮播图 -->
    <swiper
      class="swiper"
      indicator-dots="true"
      indicator-color="rgba(91,140,138,0.22)"
      indicator-active-color="#5b8c8a"
      autoplay="true"
      circular="true"
      interval="3000"
      duration="500"
    >
      <swiper-item v-for="(item, index) in banner" :key="index">
        <image :src="item.url" class="slide-image" mode="aspectFill" />
      </swiper-item>
    </swiper>

    <!-- 列表 -->
    <view class="list">
      <view class="list-head">
        <text class="list-title">医师列表</text>
        <text class="list-count">共 {{ num }} 位</text>
      </view>

      <view class="list-item" v-for="(item, index) in list" :key="index" @click="gotoDtil(item)">
        <image class="list-item-avatar" src="/static/user.png" mode="aspectFill" />
        <view class="list-item-info">
          <view class="list-item-name">{{ item.name }}</view>
          <view class="list-item-brief">{{ item.intruduce }}</view>
          <view class="list-item-tags">
            <text class="list-item-tag" v-for="(tag, tagIndex) in item.type" :key="tagIndex">{{ tag }}</text>
          </view>
        </view>
        <text class="list-item-arrow">›</text>
      </view>

      <view class="list-empty" v-if="num === 0">暂无医师数据</view>
      <text class="text-loading" v-else>— 已加载全部 {{ num }} 位医师 —</text>
    </view>
  </view>
</template>

<script>
export default {
  data() {
    return {
	  banner:[
		  {url:"/static/home/banner1.png"},
		  {url:"/static/home/banner2.png"},
		  {url:"/static/home/banner3.png"}
	  ],
      keywords: '',
      list: [],
	  num:0,
    };
  },
  onLoad(){
  	this.getDoctor(this.keywords);
  }, 
  methods: {
    onSearch() {
      this.getDoctor(this.keywords);
    },
    getDoctor(keywords) {	
	  this.num=0;
      uni.request({
        url: this.$u.baseURL + '/doctor/getAllDocter',
        method: 'GET',
        data: {
          keywords: this.keywords
        },
        success: (res) => {
          if (res.data.code == 200) {
            const r= res.data.data;
			r.forEach((item,index)=>{
				item.type = item.type.split(',').map(tag => tag.trim()); // 分割字符串并去除空格
				this.num++;
			})
				this.list=r;
          }
        },
        fail: (err) => {
          uni.showToast({
            title: '请求失败，请重试', // 提示的内容
            icon: 'none' // 没有图标
          });
        }
      });
	  this.keywords=''
    },
	//跳转至详细界面
	gotoDtil(item){
		uni.navigateTo({
			url:'/pages/tabbar/Home/detil/detil?docId='+item.id
		})
	}
	
	
  }
};
</script>

<style>
