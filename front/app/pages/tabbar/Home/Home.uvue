<template>
  <view class="container">
    <!-- 搜索框 -->
    <view class="search-box">
      <input class="search-input" type="text" v-model="keywords" placeholder="输入医生" @confirm="onSearch" />
    </view>

    <!-- 轮播图 -->
    <swiper class="swiper" indicator-dots="true" autoplay="true" interval="3000" duration="500">
      <swiper-item v-for="(item, index) in banner">
        <image :src="item.url" class="slide-image" />
      </swiper-item>
    </swiper>

    <!-- 列表 -->
		<view class="list">
		  <view class="list-title">医师列表</view>
		  <view class="list-content">
		    <view class="list-item" v-for="(item, index) in list" :key="index" @click="gotoDtil(item)">
		      <image class="list-item-avatar" src="/static/user.png" />
		      <view class="list-item-info">
		        <view class="list-item-name">{{ item.name }}</view>
		        <view class="list-item-description">
		          <text class="list-item-brief">{{ item.intruduce }}</text>
		          <view class="list-item-tags">
		            <text class="list-item-tag" v-for="(tag, tagIndex) in item.type" :key="tagIndex">{{ tag }}</text>
		          </view>
		        </view>
		      </view>
		    </view>
		  </view>
		   <text class="text-loading">~~加载完毕,共{{num}}条~~</text>
		</view>
		<view>
		    <CozeChat />
		</view>
  </view>
</template>

<script>
	
import CozeChat from '../../CozeChat/CozeChat.uvue';
export default {
  data() {
    return {
	  banner:[
		  {url:"/static/home/banner1.png"},
		  {url:"/static/home/banner2.png"},
		  {url:"/static/home/banner3.png"}
	  ],
      keywords: '',
      list: [],
	  num:0,
    };
  },
  onLoad(){
  	this.getDoctor(this.keywords);
  }, 
  components: {
      CozeChat
    },
  methods: {
    onSearch() {
      this.getDoctor(this.keywords);
    },
    getDoctor(keywords) {	
	  this.num=0;
      uni.request({
        url: this.$u.baseURL + '/doctor/getAllDocter',
        method: 'GET',
        data: {
          keywords: this.keywords
        },
        success: (res) => {
          if (res.data.code == 200) {
            const r= res.data.data;
			r.forEach((item,index)=>{
				item.type = item.type.split(',').map(tag => tag.trim()); // 分割字符串并去除空格
				this.num++;
			})
				this.list=r;
          }
        },
        fail: (err) => {
          uni.showToast({
            title: '请求失败，请重试', // 提示的内容
            icon: 'none' // 没有图标
          });
        }
      });
	  this.keywords=''
    },
	//跳转至详细界面
	gotoDtil(item){
		uni.navigateTo({
			url:'/pages/tabbar/Home/detil/detil?docId='+item.id
		})
	}
	
	
  }
};
</script>

<style>
.container {
  height: 100%;
  background-color: #e6e6fa;
  padding: 15px;
}

.search-box {
  display: flex;
  justify-content: center;
  margin-bottom: 20px;
}

.search-input {
  width: 100%;
  max-width: 500px;
  height: 40px;
  padding: 0 15px;
  border: 1px solid #ddd;
  background-color: #eee;
  border-radius: 20px;
  outline: none;
  box-sizing: border-box;
  font-size: 16px;
}

.swiper {
  width: 100%;
  height: 180px;
  overflow: hidden;
}

.slide-image {
  width: 100%;
  height: 100%;
  border-radius: 10px;
}

.list {
  margin-top: 20px;
}
.list-title {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 10px;
}

.list-content {
  display: flex;
  flex-direction: column;
}

.list-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 20px;
  padding: 10px;
  border: 1px solid #eee;
  border-radius: 10px;
  background-color: #fff;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
}

.list-item-avatar {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  margin-right: 15px;
}

.list-item-info {
  flex: 1;
}

.list-item-name {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 5px;
}

.list-item-description {
  font-size: 14px;
  color: #666;
}

.list-item-brief {
  margin-bottom: 10px;
  font-size: 14px;
  color: #666;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.list-item-tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.list-item-tag {
  padding: 4px 8px;
  margin-right: 8px;
  margin-bottom: 8px;
  background-color: #f0f0f0;
  border-radius: 15px;
  font-size: 14px;
}

.text {
  font-size: 14px;
  color: #888;
  text-align: center;
  margin-top: 10px;
}

.text-loading {
  font-size: 12px; 
  color: #888; 
  text-align: center; 
  margin-top: 10px; 
}
</style>