<template>
  <view class="page">
    <!-- 密码表单卡片 -->
    <view class="card">
      <view class="field">
        <text class="label">旧密码</text>
        <input
          class="input"
          type="password"
          v-model="oldPassword"
          placeholder="请输入旧密码"
          placeholder-style="color:#a9b4b2;font-size:15px;"
        />
      </view>

      <view class="field">
        <text class="label">新密码</text>
        <input
          class="input"
          type="password"
          v-model="newPassword"
          placeholder="6-20位，需包含字母和数字"
          placeholder-style="color:#a9b4b2;font-size:15px;"
        />
      </view>

      <view class="field field-last">
        <text class="label">确认新密码</text>
        <input
          class="input"
          type="password"
          v-model="confirmNewPassword"
          placeholder="请再次输入新密码"
          placeholder-style="color:#a9b4b2;font-size:15px;"
        />
      </view>
    </view>

    <!-- 密码要求说明 -->
    <view class="hint">
      <view class="hint-head">
        <text class="hint-bar"></text>
        <text class="hint-title">密码要求</text>
      </view>
      <view class="hint-line">· 长度 6 ~ 20 位</view>
      <view class="hint-line">· 必须同时包含字母和数字</view>
      <view class="hint-line">· 修改成功后需重新登录</view>
    </view>

    <button class="btn-primary" @click="changePassword">确认修改</button>
  </view>
</template>

<script>
export default {
  data() {
    return {
      oldPassword: '',      // 旧密码
      newPassword: '',      // 新密码
      confirmNewPassword: '' ,// 确认新密码
	  token:'',
	  user:{}
    };
  },
  onLoad(){
  	  uni.getStorage({
  		  key:'token',
  		  success:(res)=>{
  			 this.token=res.data;
  			 this.getuserInfo()
  		  }
  	  }) 
  },
  methods: {
	  //获取用户信息请求
	getuserInfo(){
		uni.request({
	  	  url:this.$u.baseURL+'/user/getUserInfo',
	  	  method: 'GET',
	  	  header:{
	  		  "token":this.token,
	  	  },
	  	  success: (res) => {
	  	   this.user=res.data.data.loginUser
	  	  },
	  	  fail: () => {
	  	    uni.showToast({
	  	      title: '网络请求失败',
	  	      icon: 'none'
	  	    });
	  	  }
		});
	},
	// 与后端一致：6-20 位且同时包含字母和数字
	isValidPassword(pwd) {
		if (!pwd || pwd.length < 6 || pwd.length > 20) return false;
		return /[A-Za-z]/.test(pwd) && /[0-9]/.test(pwd);
	},
    // 修改密码
    changePassword() {
	  if (this.oldPassword==''|| this.newPassword ==''|| this.confirmNewPassword=='') {
	    uni.showToast({
	      title: '请输入完整信息',
	      icon: 'none'
	    });
	    return;
	  }
	  if (this.newPassword !== this.confirmNewPassword) {
	    uni.showToast({
	      title: '新密码和确认密码不一致',
	      icon: 'none'
	    });
	    return;
	  }
	  if (!this.isValidPassword(this.newPassword)) {
	    uni.showToast({
	      title: '新密码需6-20位且包含字母和数字',
	      icon: 'none'
	    });
	    return;
	  }
	  uni.request({
	    url: this.$u.baseURL+'/user/changePassword', // 后端API地址
	    method: 'POST',
		header:{
				"token":this.token,
		},
	    data: {
	      "oldPassword": this.oldPassword,
	      "newPassword": this.newPassword
	    },
	    success: (res) => {
			console.log(res)
	      if (res.data.code==200) {
	       uni.removeStorage({
	       		  key:'token',
	       		  success:function(){
	       			  uni.clearStorage()
	       			  uni.showToast({
	       				  title:'密码已更改，请重新登录',
	       				  icon:'none',
	       				  duration: 1000
	       			  }),
	       			  setTimeout(() => {
	       			          uni.navigateTo({
	       			            url: '/pages/loAre/login/login'
	       			          });
	       			    }, 1000);
	       		    }
	       })
			
	      } else {
	        uni.showToast({
	          title: '密码修改失败：' + res.data.message,
	          icon: 'none'
	        });
	      }
	    },
	    fail: () => {
	      uni.showToast({
	        title: '网络请求失败',
	        icon: 'none'
	      });
	    }
	  });
    }
  }
};
</script>

<style>
.page {
  min-height: 100vh;
  padding: 16px 16px 40px;
  box-sizing: border-box;
  background-color: #f5f7fa;
}

.card {
  padding: 4px 16px;
  background-color: #ffffff;
  border-radius: 18px;
  box-shadow: 0 6px 20px rgba(91, 140, 138, 0.08);
}

.field {
  display: flex;
  flex-direction: column;
  padding: 14px 0;
  border-bottom: 1px solid #f0f3f3;
}

.field-last {
  border-bottom: none;
}

.label {
  font-size: 13px;
  color: #5a6a68;
  margin-bottom: 8px;
}

.input {
  width: 100%;
  height: 42px;
  font-size: 15px;
  color: #33413f;
}

/* ---- 说明卡片 ---- */
.hint {
  margin-top: 14px;
  padding: 16px;
  background-color: #ffffff;
  border-radius: 18px;
  box-shadow: 0 6px 20px rgba(91, 140, 138, 0.07);
}

.hint-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 10px;
}

.hint-bar {
  width: 4px;
  height: 14px;
  border-radius: 2px;
  margin-right: 8px;
  background-image: linear-gradient(180deg, #5b8c8a 0%, #7fb3b0 100%);
}

.hint-title {
  font-size: 14px;
  font-weight: 600;
  color: #33413f;
}

.hint-line {
  font-size: 13px;
  color: #8a9694;
  line-height: 23px;
}

.btn-primary {
  width: 100%;
  height: 46px;
  line-height: 46px;
  margin-top: 24px;
  font-size: 16px;
  font-weight: 600;
  color: #ffffff;
  border: none;
  border-radius: 23px;
  background-image: linear-gradient(135deg, #5b8c8a 0%, #7fb3b0 100%);
  box-shadow: 0 6px 16px rgba(91, 140, 138, 0.24);
}
</style>
