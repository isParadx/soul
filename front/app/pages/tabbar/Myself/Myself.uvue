<template>
  <view class="page">
    <!-- 顶部用户卡片 -->
    <view class="hero">
      <view class="hero-left">
        <view class="avatar">
          <image class="avatar-img" :src="avatarSrc" />
        </view>
        <view class="hero-info">
          <text class="hero-name">{{ nickname }}</text>
          <text class="hero-account">账号：{{ userid || '—' }}</text>
        </view>
      </view>
      <text class="hero-arrow" @click="goProfile">›</text>
    </view>

    <!-- 功能菜单 -->
    <view class="menu">
      <view v-for="(item, index) in menuItems" :key="index" class="menu-item" @click="navigateTo(item.url)">
        <view class="menu-item-left">
          <text class="menu-icon">{{ item.icon }}</text>
          <text class="menu-text">{{ item.text }}</text>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>

    <button class="logout-button" @click="logout">退出登录</button>
  </view>
</template>

<script>
export default {
  data() {
    return {
      token: '',
      nickname: '未登录',
      userid: '',
      img: '',
      menuItems: [
        { icon: '👤', text: '个人信息', url: '/pages/tabbar/Myself/profile/profile' },
        { icon: '🔒', text: '密码修改', url: '/pages/tabbar/Myself/password/password' },
        { icon: '💬', text: '意见反馈', url: '/pages/tabbar/Myself/advice/advice' }
      ]
    };
  },
  computed: {
    avatarSrc() {
      if (this.img) {
        if (/^https?:\/\//.test(this.img)) return this.img;
        return this.$u.baseURL + this.img;
      }
      return '/static/user.png';
    }
  },
  onShow() {
    this.token = uni.getStorageSync('token') || '';
    if (this.token) {
      this.getUserInfo();
    } else {
      this.nickname = '未登录';
      this.userid = '';
    }
  },
  methods: {
    getUserInfo() {
      uni.request({
        url: this.$u.baseURL + '/user/getUserInfo',
        method: 'GET',
        header: { token: this.token },
        success: (res) => {
          const loginUser = res.data && res.data.data && res.data.data.loginUser;
          if (loginUser) {
            this.nickname = loginUser.nickname || '未设置昵称';
            this.userid = loginUser.userid || '';
            this.img = loginUser.img || '';
          }
        }
      });
    },
    goProfile() {
      uni.navigateTo({ url: '/pages/tabbar/Myself/profile/profile' });
    },
    navigateTo(url) {
      uni.navigateTo({ url });
    },
    logout() {
      uni.showModal({
        title: '提示',
        content: '确定要退出登录吗？',
        success: (r) => {
          if (!r.confirm) return;
          uni.clearStorageSync();
          uni.showToast({ title: '已退出登录', icon: 'none', duration: 1000 });
          setTimeout(() => {
            uni.reLaunch({ url: '/pages/loAre/login/login' });
          }, 1000);
        }
      });
    }
  }
};
</script>

<style>
.page {
  min-height: 100vh;
  padding: 16px 16px 32px;
  box-sizing: border-box;
  background-color: #f5f7fa;
}

/* 顶部用户卡片 */
.hero {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #5b8c8a 0%, #7fb3b0 100%);
  border-radius: 16px;
  padding: 22px 20px;
}

.hero-left {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.avatar {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  overflow: hidden;
  border: 2px solid rgba(255, 255, 255, 0.75);
  background-color: #ffffff;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.hero-info {
  margin-left: 14px;
  display: flex;
  flex-direction: column;
}

.hero-name {
  font-size: 18px;
  font-weight: 600;
  color: #ffffff;
}

.hero-account {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 6px;
  letter-spacing: 0.5px;
}

.hero-arrow {
  color: rgba(255, 255, 255, 0.9);
  font-size: 22px;
}

/* 菜单 */
.menu {
  background-color: #ffffff;
  border-radius: 14px;
  margin-top: 16px;
  padding: 0 16px;
  box-shadow: 0 2px 12px rgba(91, 140, 138, 0.06);
}

.menu-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: 54px;
  border-bottom: 1px solid #f0f3f3;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item-left {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.menu-icon {
  font-size: 17px;
  margin-right: 12px;
}

.menu-text {
  font-size: 15px;
  color: #33413f;
}

.arrow {
  font-size: 20px;
  color: #c0cbca;
}

.logout-button {
  width: 100%;
  height: 46px;
  line-height: 46px;
  margin-top: 28px;
  background-color: #ffffff;
  color: #e45656;
  font-size: 16px;
  border-radius: 23px;
  border: 1px solid #f3d9d9;
}
</style>
