<template>
  <view class="container">
    <!-- 头像和昵称区域 -->
    <view class="profile">
      <view class="avatar">
        <image class="avatar-img" src="/static/user.png" />
      </view>
      <text class="avatar-nickname">{{nickname}}</text>
    </view>
  
    <!-- 菜单区域 -->
    <view class="menu">
      <view v-for="(item, index) in menuItems" :key="index" class="menu-item" @click="navigateTo(item.url)">
        <view class="menu-item-left">
          <view :class="item.icon"></view>
          <text class="menu-text">{{ item.text }}</text>
        </view>
        <text class="arrow">></text>
      </view>
    </view>
    
    <!-- 退出按钮 -->
    <button class="logout-button" @click="logout">退出</button>
  </view>
</template>

<script>
export default {
  data() {
    return {
      nickname: 'hi!欢迎使用',
      menuItems: [
        { icon: 'icon-info', text: '个人信息', url: '/pages/tabbar/Myself/profile/profile' },
        { icon: 'icon-lock', text: '密码修改', url: '/pages/tabbar/Myself/password/password' },
        { icon: 'icon-advice;', text: '意见反馈', url: '/pages/tabbar/Myself/advice/advice' }
      ]
    };
  },
  onLoad() {
  	uni.getStorage({
  			  key:'token',
  			  success:(res)=>{
  				 this.token=res.data;
  			}
  	}) 
  },
  methods: { 
    navigateTo(url) {
		uni.navigateTo({
			url: url
		});
    },
    logout() {
      uni.removeStorage({
		  key:'token',
		  success:function(){
			  uni.clearStorage()
			  uni.showToast({
				  title:'退出成功，请重新登录',
				  icon:'none',
				  duration: 1000
			  }),
			  setTimeout(() => {
			          uni.navigateTo({
			            url: '/pages/loAre/login/login'
			          });
			        }, 1000);
			  
		  }
	  })
    }
  }
};
</script>

