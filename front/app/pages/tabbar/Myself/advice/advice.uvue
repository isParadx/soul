<template>
  <view class="page">
    <!-- 反馈输入卡片 -->
    <view class="card">
      <textarea
        class="feedback-input"
        v-model="feedbackContent"
        placeholder="请输入您的意见反馈..."
        placeholder-style="color:#a9b4b2;font-size:15px;"
        maxlength="200"
      />
      <view class="word">
        <text class="word-count">{{ feedbackLength }}/200</text>
      </view>
    </view>

    <!-- 匿名说明 -->
    <view class="notice">
      <view class="notice-head">
        <text class="notice-bar"></text>
        <text class="notice-title">我们承诺</text>
      </view>
      <view class="notice-line">该意见反馈始终为匿名反馈，感谢您的宝贵意见。</view>
    </view>

    <button class="btn-primary" @click="submitFeedback">提交反馈</button>
  </view>
</template>

<script>
export default {
  data() {
    return {
      feedbackContent: '', // 用户输入的反馈内容
      feedbackLength: 200, // 初始剩余字数
	  token: ''
    };
  },
  onLoad() {
	this.token = uni.getStorageSync('token') || '';
  },
  watch: {
    feedbackContent(newVal) {
      this.feedbackLength = 200 - newVal.length;
    }
  },
  methods: {
    // 提交反馈
    submitFeedback() {
      if (this.feedbackContent.trim() === '') {
        uni.showToast({
          title: '请输入意见反馈内容',
          icon: 'none'
        });
        return;
      }else{
		  uni.request({
		    url: this.$u.baseURL+'/advice/putAdvice',
		    method: 'POST',
		    header:{
		  	  token:this.token
		    },
		    data: this.feedbackContent,
		    success: (res) => {
				console.log(res);
		      if (res.data.code == 200) {
		  		uni.showToast({
		  						  title:'提交成功，感谢您宝贵的意见！',
		  						  icon:'none',
		  						  duration: 500
		  		}),
		  		setTimeout(() => {
		  		        uni.switchTab({
		  		          url: '/pages/tabbar/Myself/Myself'
		  		        });
		  		      }, 500);
		      } else {
		        uni.showToast({
		          title: '保存失败，请重试',
		          icon: 'none'
		        });
		      }
		    },
		    fail: () => {
		      uni.showToast({
		        title: '网络请求失败',
		        icon: 'none'
		      });
		    }
		  });
	  }
      
    }
  }
};
</script>

<style>
.page {
  min-height: 100vh;
  padding: 16px 16px 40px;
  box-sizing: border-box;
  background-color: #f5f7fa;
}

.card {
  padding: 16px;
  background-color: #ffffff;
  border-radius: 18px;
  box-shadow: 0 6px 20px rgba(91, 140, 138, 0.08);
}

.feedback-input {
  width: 100%;
  height: 160px;
  font-size: 15px;
  color: #33413f;
  line-height: 24px;
}

.word {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  margin-top: 6px;
}

.word-count {
  font-size: 12px;
  color: #b3bdbb;
}

/* ---- 匿名说明 ---- */
.notice {
  margin-top: 14px;
  padding: 16px;
  background-color: #ffffff;
  border-radius: 18px;
  box-shadow: 0 6px 20px rgba(91, 140, 138, 0.07);
}

.notice-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 10px;
}

.notice-bar {
  width: 4px;
  height: 14px;
  border-radius: 2px;
  margin-right: 8px;
  background-image: linear-gradient(180deg, #5b8c8a 0%, #7fb3b0 100%);
}

.notice-title {
  font-size: 14px;
  font-weight: 600;
  color: #33413f;
}

.notice-line {
  font-size: 13px;
  color: #8a9694;
  line-height: 22px;
}

.btn-primary {
  width: 100%;
  height: 46px;
  line-height: 46px;
  margin-top: 24px;
  font-size: 16px;
  font-weight: 600;
  color: #ffffff;
  border: none;
  border-radius: 23px;
  background-image: linear-gradient(135deg, #5b8c8a 0%, #7fb3b0 100%);
  box-shadow: 0 6px 16px rgba(91, 140, 138, 0.24);
}
</style>
