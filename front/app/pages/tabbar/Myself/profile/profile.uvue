<template>
  <view class="page">
    <!-- 顶部个人卡片 -->
    <view class="hero">
      <view class="avatar" @click="editAvatar">
        <image class="avatar-img" :src="avatarSrc" />
      </view>
      <view class="hero-name">{{ user.nickname || '未设置昵称' }}</view>
      <view class="hero-account">账号：{{ user.userid || '—' }}</view>
      <view class="hero-badge">学生</view>
    </view>

    <!-- 信息编辑卡 -->
    <view class="card">
      <view class="cell">
        <text class="cell-label">昵称</text>
        <input class="cell-input" type="text" v-model="user.nickname" placeholder="请输入昵称" />
      </view>

      <view class="cell">
        <text class="cell-label">手机号</text>
        <input class="cell-input" type="number" maxlength="11" v-model="user.phone" placeholder="请输入手机号" />
      </view>

      <view class="cell">
        <text class="cell-label">性别</text>
        <picker class="cell-picker" mode="selector" :range="genders" :value="sexIndex" @change="onGenderChange">
          <view class="picker-value">
            <text>{{ genders[sexIndex] }}</text>
            <text class="arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="cell last">
        <text class="cell-label">邮箱</text>
        <input class="cell-input" type="text" v-model="user.email" placeholder="请输入邮箱（选填）" />
      </view>
    </view>

    <button class="btn-primary" :loading="saving" @click="saveInfo">{{ saving ? '保存中...' : '保存修改' }}</button>
  </view>
</template>

<script>
export default {
  data() {
    return {
      token: '',
      saving: false,
      user: {
        userid: '',
        nickname: '',
        phone: '',
        sex: 0,
        email: '',
        img: ''
      },
      genders: ['男', '女']
    };
  },
  computed: {
    sexIndex() {
      const s = Number(this.user.sex);
      return (s === 0 || s === 1) ? s : 0;
    },
    avatarSrc() {
      if (this.user.img) {
        if (/^https?:\/\//.test(this.user.img)) return this.user.img;
        return this.$u.baseURL + this.user.img;
      }
      return '/static/user.png';
    }
  },
  onShow() {
    this.token = uni.getStorageSync('token') || '';
    if (this.token) {
      this.getuserInfo();
    }
  },
  methods: {
    getuserInfo() {
      uni.request({
        url: this.$u.baseURL + '/user/getUserInfo',
        method: 'GET',
        header: { token: this.token },
        success: (res) => {
          const loginUser = res.data && res.data.data && res.data.data.loginUser;
          if (loginUser) {
            this.user = Object.assign({}, this.user, loginUser);
            if (this.user.sex === null || this.user.sex === undefined) this.user.sex = 0;
          }
        },
        fail: () => {
          uni.showToast({ title: '网络请求失败', icon: 'none' });
        }
      });
    },
    editAvatar() {
      uni.showToast({ title: '请在电脑端更换头像', icon: 'none' });
    },
    onGenderChange(e) {
      this.user.sex = Number(e.detail.value);
    },
    validate() {
      if (!this.user.nickname) return '请输入昵称';
      if (!/^1[3-9]\d{9}$/.test(this.user.phone)) return '手机号格式不正确';
      if (this.user.email && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(this.user.email)) return '邮箱格式不正确';
      return null;
    },
    saveInfo() {
      const err = this.validate();
      if (err) {
        uni.showToast({ title: err, icon: 'none' });
        return;
      }
      this.saving = true;
      uni.request({
        url: this.$u.baseURL + '/user/changeUserInfo',
        method: 'POST',
        header: { token: this.token },
        data: {
          nickname: this.user.nickname,
          phone: String(this.user.phone),
          sex: this.sexIndex,
          email: this.user.email || ''
        },
        success: (res) => {
          if (res.data.code === 200) {
            uni.showToast({ title: '修改成功', icon: 'success', duration: 1000 });
            this.getuserInfo();
          } else {
            uni.showToast({ title: res.data.message || '保存失败，请重试', icon: 'none' });
          }
        },
        fail: () => {
          uni.showToast({ title: '网络请求失败', icon: 'none' });
        },
        complete: () => {
          this.saving = false;
        }
      });
    }
  }
};
</script>

<style>
.page {
  min-height: 100vh;
  padding: 16px 16px 32px;
  box-sizing: border-box;
  background-color: #f5f7fa;
}

/* 顶部个人卡片 */
.hero {
  background: linear-gradient(135deg, #5b8c8a 0%, #7fb3b0 100%);
  border-radius: 16px;
  padding: 26px 20px 22px;
  align-items: center;
  display: flex;
  flex-direction: column;
}

.avatar {
  width: 76px;
  height: 76px;
  border-radius: 50%;
  border: 3px solid rgba(255, 255, 255, 0.7);
  overflow: hidden;
  background-color: #ffffff;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.hero-name {
  font-size: 19px;
  font-weight: 600;
  color: #ffffff;
  margin-top: 12px;
}

.hero-account {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 6px;
  letter-spacing: 0.5px;
}

.hero-badge {
  margin-top: 10px;
  padding: 3px 12px;
  font-size: 12px;
  color: #ffffff;
  background-color: rgba(255, 255, 255, 0.22);
  border-radius: 12px;
}

/* 列表式表单卡片 */
.card {
  background-color: #ffffff;
  border-radius: 18px;
  margin-top: 16px;
  padding: 0 16px;
  box-shadow: 0 6px 20px rgba(91, 140, 138, 0.08);
}

.cell {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 52px;
  border-bottom: 1px solid #f0f3f3;
}

.cell.last {
  border-bottom: none;
}

.cell-label {
  width: 74px;
  font-size: 14px;
  color: #5a6a68;
}

.cell-input {
  flex: 1;
  height: 46px;
  font-size: 15px;
  color: #33413f;
  text-align: right;
}

.cell-picker {
  flex: 1;
}

.picker-value {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  height: 46px;
  font-size: 15px;
  color: #33413f;
}

.arrow {
  margin-left: 6px;
  color: #b0bcba;
  font-size: 18px;
}

.btn-primary {
  width: 100%;
  height: 46px;
  line-height: 46px;
  margin-top: 24px;
  color: #ffffff;
  font-size: 16px;
  font-weight: 600;
  border-radius: 23px;
  border: none;
  background-image: linear-gradient(135deg, #5b8c8a 0%, #7fb3b0 100%);
  box-shadow: 0 6px 16px rgba(91, 140, 138, 0.24);
}
</style>
